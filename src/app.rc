/* Windows resources: application icon and version information.
 * ASCII only, to avoid windres encoding problems. */
#include <windows.h>

/* Application icon (title bar / task bar / Explorer).
 * A numeric ID is required: only then does windres emit both RT_ICON and
 * RT_GROUP_ICON, which is what Explorer needs to show the exe icon. */
#define IDI_APP_ICON 101
IDI_APP_ICON ICON DISCARDABLE "../resources/icons/logo.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "WeAct Studio"
            VALUE "FileDescription", "WeAct Studio DAP Flasher"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "WeAct Studio DAP Flasher"
            VALUE "LegalCopyright", "Copyright (C) 2026 WeAct Studio"
            VALUE "OriginalFilename", "WeAct Studio DAP Flasher.exe"
            VALUE "ProductName", "WeAct Studio DAP Flasher"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
